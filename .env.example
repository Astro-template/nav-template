# Astro Navigation - Environment Variables Example
# Copy this file to .env and fill in your values

# Site Configuration
PUBLIC_SITE_URL=https://affnav.github.io
PUBLIC_SITE_TITLE=Affiliate导航
PUBLIC_SITE_DESCRIPTION=专业的Affiliate营销导航网站

# API Configuration (if needed)
# PUBLIC_API_BASE_URL=https://api.example.com

# Analytics (optional)
# PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
# PUBLIC_PLAUSIBLE_DOMAIN=affnav.github.io

# Performance Monitoring
PUBLIC_ENABLE_PERFORMANCE_MONITOR=true
PUBLIC_CACHE_TTL=3600000

# Feature Flags
PUBLIC_ENABLE_LAZY_LOADING=true
PUBLIC_ENABLE_PWA=false

# Development
NODE_ENV=development

# Build Configuration
PUBLIC_CONFIG_PATH=/config.json
PUBLIC_CATEGORIES_PATH=/categories

# Error Tracking (optional)
# PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Security
# Note: Never commit .env file to version control
# Add .env to .gitignore
