# pnpm 严格模式配置 - 防止幽灵依赖问题

# ==================== 严格依赖管理 ====================

# 启用严格的 peer dependencies 检查
strict-peer-dependencies=true

# 禁止访问未在 package.json 中声明的依赖（防止幽灵依赖）
# 这是 pnpm 的核心特性，确保只能导入明确声明的包
auto-install-peers=true

# 如果 peer dependency 缺失，安装时会自动安装
# 设置为 false 会在缺失时报错
resolve-peers-from-workspace-root=true


# ==================== 性能优化 ====================

# 使用硬链接从存储中链接包（默认启用，这里显式声明）
# 这可以节省大量磁盘空间
package-import-method=auto

# 提升性能：并行安装
# network-concurrency 控制同时下载的包数量
network-concurrency=16

# 锁文件设置
lockfile=true
lockfile-include-tarball-url=true


# ==================== 工作空间设置 ====================

# 如果是 monorepo，启用工作空间支持
# 当前项目是单仓库，但保留配置以备将来使用
shamefully-hoist=false

# 不提升依赖到根目录（防止幽灵依赖）
# false 是默认值，这里显式声明以示重要性
hoist=false

# 提升模式：仅提升某些包（如果需要的话）
# public-hoist-pattern[]=*eslint*
# public-hoist-pattern[]=*prettier*


# ==================== 安全性 ====================

# 在安装时验证包的完整性
verify-store-integrity=true

# 每次安装后检查包的完整性
package-lock=true


# ==================== Node 版本管理 ====================

# 使用项目指定的 Node 版本（如果有 .nvmrc 或 package.json 中的 engines）
engine-strict=true


# ==================== 日志和调试 ====================

# 显示更详细的错误信息
loglevel=info

# 报告安装进度
progress=true


# ==================== 其他优化 ====================

# 启用模块目录的符号链接
symlink=true

# 全局安装时的行为
prefer-workspace-packages=true

# 忽略脚本（安全考虑，可以根据需要调整）
# ignore-scripts=false

# 保存精确版本号（推荐用于生产项目）
save-exact=false

# 使用 ~ 还是 ^ 作为版本前缀
save-prefix='^'
