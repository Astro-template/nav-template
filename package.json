{
  "name": "astro-nav",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm run build-config && astro dev",
    "dev:watch": "pnpm run copy-config:watch & astro dev",
    "start": "pnpm run build-config && astro dev",
    "build": "pnpm run build-config && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build-config": "node scripts/build-config.js",
    "prepare-config": "node scripts/prepare-config.js",
    "copy-config": "node scripts/copy-config.js",
    "copy-config:watch": "node scripts/copy-config.js --watch",
    "check-deps": "node scripts/check-dependencies.cjs",
    "check": "pnpm astro check && pnpm run check-deps",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --ext .ts,.astro",
    "lint:fix": "eslint . --ext .ts,.astro --fix",
    "format": "prettier --write \"**/*.{ts,astro,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,astro,md,json}\"",
    "validate": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/sitemap": "^3.6.0",
    "@types/busboy": "^1.5.4",
    "astro": "^5.15.1",
    "busboy": "^1.6.0",
    "jszip": "^3.10.1",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.5",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5"
  }
}
